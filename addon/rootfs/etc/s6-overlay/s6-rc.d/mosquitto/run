#!/command/with-contenv bash
# Start Mosquitto MQTT broker using the config file generated by run.sh.
# Falls back to an anonymous in-memory config if the generated file is absent.
if [ -f /data/mosquitto/mosquitto.conf ]; then
    CONF=/data/mosquitto/mosquitto.conf
else
    # Minimal fallback so the broker still starts during first-boot race.
    CONF=/dev/stdin
    exec mosquitto -c /dev/stdin 2>&1 << 'EOF'
listener 1883
allow_anonymous true
persistence false
log_dest stdout
EOF
fi
exec mosquitto -c "${CONF}" 2>&1
