#!/command/with-contenv bash
# dbus-mqtt: bridges the Venus D-Bus value-tree to the local Mosquitto broker.
#
# Topics follow the VRM Portal convention so that Home Assistant's MQTT
# integration can auto-discover Victron entities:
#   N/<portalid>/system/0/Dc/Battery/Soc
#   N/<portalid>/battery/0/Dc/0/Voltage
#   ...
#
# Config is generated by run.sh at /etc/dbus-mqtt/config.ini.
export PYTHONPATH=/opt/victron/velib_python

# Force all Venus daemons to use the container-private system bus.
# The HA base image or supervisor may inject DBUS_SYSTEM_BUS_ADDRESS or
# DBUS_SESSION_BUS_ADDRESS pointing to the host/HA bus.
unset DBUS_SESSION_BUS_ADDRESS
export DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket

CONF=/etc/dbus-mqtt/config.ini
if [ ! -f "${CONF}" ]; then
    echo "[WARN] /etc/dbus-mqtt/config.ini not found; dbus-mqtt may use defaults."
fi

exec python3 -u /opt/victron/dbus-mqtt/dbus_mqtt.py \
    2>&1
